<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed / heads-up countdown. Chronometer ticks and ViewFlipper pulses on
     their own, so the notification is posted once. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ViewFlipper
        android:id="@+id/countdown_flipper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:autoStart="true"
        android:flipInterval="800"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ OdakLan'a geri dön!"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Seans bozulmak üzere!"
            android:textColor="@color/countdown_alert"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textStyle="bold" />
    </ViewFlipper>

    <Chronometer
        android:id="@+id/countdown_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="monospace"
        android:textColor="@color/countdown_alert"
        android:textSize="30sp"
        android:textStyle="bold" />
</LinearLayout>
