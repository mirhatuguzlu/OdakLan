<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded countdown: big ticking number, pulsing warning, animated bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <Chronometer
        android:id="@+id/countdown_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/countdown_alert"
        android:textSize="56sp"
        android:textStyle="bold" />

    <ViewFlipper
        android:id="@+id/countdown_flipper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:autoStart="true"
        android:flipInterval="800"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ OdakLan'a geri dön!"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Seans bozulmak üzere!"
            android:textColor="@color/countdown_alert"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textStyle="bold" />
    </ViewFlipper>

    <ProgressBar
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/countdown_alert" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Süre dolunca seans bozulur ve şehrin hasar alır."
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />
</LinearLayout>
